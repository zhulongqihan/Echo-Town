{
  "schema_version": "1.0.0",
  "storage_key": "echo-town-save",
  "legacy_storage_keys": ["echo-town-mvp-v1"],
  "save_version": 3,
  "accepted_versions": [1, 2, 3],
  "max_save_bytes": 524288,
  "screen_values": ["start", "game", "ending", "archive"],
  "life_status_values": ["active", "complete"],
  "plan_values": ["repair", "witness", "lantern"],
  "world": {
    "completedLives": {"type": "integer", "min": 0, "max": 9999},
    "tracks": ["bridge", "river", "trust", "archive", "workshop", "light"],
    "people": ["ahe", "qishu", "lin", "children"],
    "history_max": 20,
    "echoes_max": 120,
    "discoveries_max": 40,
    "relics_max": 20
  },
  "current_life": {
    "generation": {"type": "integer", "min": 1, "max": 9999},
    "stage": {"type": "integer", "min": 0, "max": 11},
    "seed": {"type": "uint32", "min": 0, "max": 4294967295},
    "stats": {
      "health": {"min": 0, "max": 3},
      "coins": {"min": 0, "max": 6},
      "courage": {"min": 0, "max": 5},
      "bond": {"min": 0, "max": 6},
      "craft": {"min": 0, "max": 6},
      "insight": {"min": 0, "max": 6}
    },
    "choices_max": 12,
    "echoes_max": 12,
    "relics_max": 20,
    "discoveries_max": 20,
    "text_max": 240
  },
  "import_policy": {
    "parse_before_replace": true,
    "reject_keeps_current_save": true,
    "normalize_before_persist": true,
    "execute_imported_markup": false
  }
}
